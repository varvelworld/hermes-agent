# =============================================================================
# Dev Agent Container — Configuration
# Copy this file to .env and fill in your settings:
#   cp .env.example .env
# =============================================================================

# --- Workspace (host directory mounted at /workspace inside container) --------
# Create the directory first if it doesn't exist:
#   mkdir -p ~/code/workspace
WORKSPACE_DIR=~/code/workspace

# --- Proxy (host machine proxy forwarded into container) ----------------------
# Set to your local proxy port; leave empty to disable
PROXY_PORT=7890

# --- Anthropic (required for Claude Code, also used by Hermes) ---------------
ANTHROPIC_API_KEY=

# --- OpenAI (used by Hermes and OpenCode) ------------------------------------
OPENAI_API_KEY=

# --- OpenCode Zen (alternative to OpenAI for OpenCode) -----------------------
# OPENCODE_API_KEY=

# --- Optional providers (used by Hermes) -------------------------------------
# GOOGLE_API_KEY=
# FIREWORKS_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# --- Optional tools (used by Hermes) -----------------------------------------
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
